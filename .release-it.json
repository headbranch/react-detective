{
  "$schema": "https://unpkg.com/release-it@20/schema/release-it.json",
  "hooks": {
    "before:init": "npm test",
    "after:bump": "npm run build"
  },
  "git": {
    "requireBranch": "main",
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}"
  },
  "github": {
    "release": true,
    "releaseName": "v${version}"
  },
  "npm": {
    "publish": true
  }
}
